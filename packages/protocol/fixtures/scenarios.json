{
  "about": "Shared behavior scenarios: command sequences and the acks they must produce, run against both the simulated daemon (packages/sim-daemon/test/scenarios.test.ts) and the real one (apps/daemon/tests/chaos.rs, shared_scenarios_*), so the two can't drift apart. Each step either sends a command or crashes the engine (it restarts from its snapshot). `expect` is matched as a subset of the ack. Stream steps check `streamWanted`, not `stream`, and recording steps `recordingWanted`, not `recording`: the simulated daemon simulates both itself, while the real engine reports them only once the video process does. New behavior goes here first: protocol, then sim-daemon, then the real daemon. Add scenarios; never change an existing expectation without a protocol version bump. `connection` says who sends the steps: absent, any trusted connection (the church computer's local channel, or a device that has paired and proven its key); churchComputer, only the local channel; unpaired, a device on the network channel that hasn't paired or proven its key. A runner that can't make that kind of connection skips the scenario.",
  "scenarios": [
    {
      "name": "navigates and clamps at both ends",
      "slides": 5,
      "steps": [
        { "send": { "type": "slide.prev" }, "expect": { "ok": true, "state": { "slideIndex": 0 } } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "slideIndex": 1 } } },
        { "send": { "type": "slide.goto", "index": 4 }, "expect": { "ok": true, "state": { "slideIndex": 4 } } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "slideIndex": 4 } } },
        { "send": { "type": "slide.prev" }, "expect": { "ok": true, "state": { "slideIndex": 3 } } }
      ]
    },
    {
      "name": "a slide out of range is refused and changes nothing",
      "slides": 5,
      "steps": [
        { "send": { "type": "slide.goto", "index": 2 }, "expect": { "ok": true, "state": { "slideIndex": 2 } } },
        { "send": { "type": "slide.goto", "index": 5 }, "expect": { "ok": false, "code": "bad_arguments" } },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "slideIndex": 2 } } }
      ]
    },
    {
      "name": "black screens and back, keeping the slide",
      "slides": 5,
      "steps": [
        { "send": { "type": "slide.goto", "index": 3 }, "expect": { "ok": true } },
        { "send": { "type": "output.black", "on": true }, "expect": { "ok": true, "state": { "slideIndex": 3, "black": true } } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "slideIndex": 4, "black": true } } },
        { "send": { "type": "output.black", "on": false }, "expect": { "ok": true, "state": { "slideIndex": 4, "black": false } } }
      ]
    },
    {
      "name": "every ack reports the whole state, state.get included",
      "slides": 5,
      "steps": [
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "slideIndex": 0, "black": false, "stream": "off", "streamWanted": false } } },
        { "send": { "type": "slide.goto", "index": 2 }, "expect": { "ok": true, "state": { "slideIndex": 2, "black": false, "stream": "off", "streamWanted": false } } }
      ]
    },
    {
      "name": "a crash comes back on the same slide and black state",
      "slides": 10,
      "steps": [
        { "send": { "type": "slide.goto", "index": 6 }, "expect": { "ok": true } },
        { "send": { "type": "output.black", "on": true }, "expect": { "ok": true } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "slideIndex": 6, "black": true } } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "slideIndex": 7, "black": true } } }
      ]
    },
    {
      "name": "two crashes in a row lose nothing",
      "slides": 10,
      "steps": [
        { "send": { "type": "slide.goto", "index": 8 }, "expect": { "ok": true } },
        { "crash": true },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "slideIndex": 8, "black": false } } }
      ]
    },
    {
      "name": "a wanted stream stays wanted through a crash, and stop is kept too",
      "slides": 5,
      "steps": [
        { "send": { "type": "stream.start" }, "expect": { "ok": true, "state": { "streamWanted": true } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "streamWanted": true } } },
        { "send": { "type": "stream.stop" }, "expect": { "ok": true, "state": { "streamWanted": false, "stream": "off" } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "streamWanted": false, "stream": "off" } } }
      ]
    },
    {
      "name": "a recording is off until asked for, and every ack says so",
      "slides": 5,
      "steps": [
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "recording": "off", "recordingWanted": false, "recordingLowDisk": false } } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "recording": "off", "recordingWanted": false, "recordingLowDisk": false } } }
      ]
    },
    {
      "name": "a wanted recording stays wanted through a crash, and stop is kept too",
      "slides": 5,
      "steps": [
        { "send": { "type": "recording.start" }, "expect": { "ok": true, "state": { "recordingWanted": true } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "recordingWanted": true } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "recordingWanted": true } } },
        { "send": { "type": "recording.stop" }, "expect": { "ok": true, "state": { "recordingWanted": false, "recording": "off" } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "recordingWanted": false, "recording": "off" } } }
      ]
    },
    {
      "name": "the recording and the stream are separate: stopping one never touches the other",
      "slides": 5,
      "steps": [
        { "send": { "type": "recording.start" }, "expect": { "ok": true, "state": { "recordingWanted": true, "streamWanted": false } } },
        { "send": { "type": "stream.start" }, "expect": { "ok": true, "state": { "recordingWanted": true, "streamWanted": true } } },
        { "send": { "type": "stream.stop" }, "expect": { "ok": true, "state": { "recordingWanted": true, "streamWanted": false } } },
        { "send": { "type": "stream.start" }, "expect": { "ok": true, "state": { "recordingWanted": true, "streamWanted": true } } },
        { "send": { "type": "recording.stop" }, "expect": { "ok": true, "state": { "recordingWanted": false, "streamWanted": true } } },
        { "crash": true },
        { "send": { "type": "state.get" }, "expect": { "ok": true, "state": { "recordingWanted": false, "streamWanted": true } } }
      ]
    },
    {
      "name": "starting a recording twice, or stopping one that isn't running, is harmless",
      "slides": 5,
      "steps": [
        { "send": { "type": "recording.stop" }, "expect": { "ok": true, "state": { "recordingWanted": false } } },
        { "send": { "type": "recording.start" }, "expect": { "ok": true, "state": { "recordingWanted": true } } },
        { "send": { "type": "recording.start" }, "expect": { "ok": true, "state": { "recordingWanted": true } } },
        { "send": { "type": "recording.stop" }, "expect": { "ok": true, "state": { "recordingWanted": false } } },
        { "send": { "type": "recording.stop" }, "expect": { "ok": true, "state": { "recordingWanted": false } } }
      ]
    },
    {
      "name": "pairing is closed until the church computer opens it, and only it can list or remove devices",
      "slides": 5,
      "connection": "churchComputer",
      "steps": [
        { "send": { "type": "device.list" }, "expect": { "ok": true, "devices": [] } },
        { "send": { "type": "pair.open" }, "expect": { "ok": true, "pairing": { "open": true, "requests": [] } } },
        { "send": { "type": "pair.close" }, "expect": { "ok": true, "pairing": { "open": false, "requests": [] } } },
        { "send": { "type": "pair.approve", "requestId": "nope" }, "expect": { "ok": false, "code": "bad_arguments" } },
        { "send": { "type": "pair.deny", "requestId": "nope" }, "expect": { "ok": false, "code": "bad_arguments" } },
        { "send": { "type": "device.remove", "deviceId": "nope" }, "expect": { "ok": false, "code": "bad_arguments" } },
        { "send": { "type": "slide.next" }, "expect": { "ok": true, "state": { "slideIndex": 1 } } }
      ]
    },
    {
      "name": "an unpaired device can only ask to pair or prove its key, and nothing else",
      "slides": 5,
      "connection": "unpaired",
      "steps": [
        { "send": { "type": "state.get" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "slide.next" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "output.black", "on": true }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "stream.start" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "state.subscribe" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "stream.report", "status": "live" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "recording.report", "status": "recording" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "media.levels", "peakDb": [-6], "rmsDb": [-18] }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "pair.open" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "pair.approve", "requestId": "r1" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "device.list" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "device.remove", "deviceId": "d1" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "pair.request", "publicKey": "BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "name": "Phone" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "auth.prove", "signature": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "auth.hello", "publicKey": "BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }, "expect": { "ok": true } },
        { "send": { "type": "auth.prove", "signature": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }, "expect": { "ok": false, "code": "unauthorized" } },
        { "send": { "type": "state.get" }, "expect": { "ok": false, "code": "unauthorized" } }
      ]
    }
  ]
}
