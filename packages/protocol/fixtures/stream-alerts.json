{
  "about": "Alerts between two stream reports (streamAlerts in packages/protocol, stream_alerts in the Rust daemon). Both must give exactly these, word for word. Add cases; change a message only on purpose, in both places.",
  "cases": [
    {"name": "nothing changed", "before": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "1080p"}, {"id": "fb", "name": "Facebook", "state": "live", "quality": "720p"}], "after": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "1080p"}, {"id": "fb", "name": "Facebook", "state": "live", "quality": "720p"}], "expect": []},
    {"name": "lowered", "before": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "1080p"}], "after": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "720p"}], "expect": [{"kind": "stream.lowered", "destinationId": "yt", "name": "YouTube", "quality": "720p", "message": "YouTube lowered to 720p: the internet upload is slow. It goes back up by itself."}]},
    {"name": "raised is good news, not an alert", "before": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "480p"}], "after": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "720p"}], "expect": []},
    {"name": "paused", "before": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "1080p"}, {"id": "fb", "name": "Facebook", "state": "live", "quality": "720p"}], "after": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "480p"}, {"id": "fb", "name": "Facebook", "state": "paused", "quality": ""}], "expect": [{"kind": "stream.lowered", "destinationId": "yt", "name": "YouTube", "quality": "480p", "message": "YouTube lowered to 480p: the internet upload is slow. It goes back up by itself."}, {"kind": "stream.paused", "destinationId": "fb", "name": "Facebook", "quality": "", "message": "Facebook is paused: the internet upload can't carry it right now. It comes back by itself when the upload recovers."}]},
    {"name": "resumed", "before": [{"id": "fb", "name": "Facebook", "state": "paused", "quality": ""}], "after": [{"id": "fb", "name": "Facebook", "state": "connecting", "quality": "360p"}], "expect": [{"kind": "stream.resumed", "destinationId": "fb", "name": "Facebook", "quality": "360p", "message": "Facebook is streaming again, at 360p."}]},
    {"name": "still paused says nothing more", "before": [{"id": "fb", "name": "Facebook", "state": "paused", "quality": ""}], "after": [{"id": "fb", "name": "Facebook", "state": "paused", "quality": ""}], "expect": []},
    {"name": "a platform that just appeared isn't an alert", "before": [], "after": [{"id": "fb", "name": "Facebook", "state": "paused", "quality": ""}], "expect": []},
    {"name": "reconnecting isn't the bandwidth manager's doing", "before": [{"id": "yt", "name": "YouTube", "state": "live", "quality": "1080p"}], "after": [{"id": "yt", "name": "YouTube", "state": "reconnecting", "quality": "1080p"}], "expect": []},
    {"name": "a platform with no name goes by its id", "before": [{"id": "vimeo", "name": "", "state": "live", "quality": "720p"}], "after": [{"id": "vimeo", "name": "", "state": "paused", "quality": ""}], "expect": [{"kind": "stream.paused", "destinationId": "vimeo", "name": "vimeo", "quality": "", "message": "vimeo is paused: the internet upload can't carry it right now. It comes back by itself when the upload recovers."}]}
  ]
}
